(version 1)

# Project custom design rules — additive to the .kicad_pro design_settings
# (which already enforce edge clearance, via/track/hole minimums, silk, text).
# kicad-cli pcb drc and KiBot's drc preflight auto-load this file.

# The IR drive nets (IR_Drive class) carry ~400 mA pulsed through the LED
# strings + Q3; they are routed at the class nominal 0.5 mm. Enforce a hard
# minimum so a future edit / re-route can't silently neck one down to a
# signal width and overheat.
(rule "IR_Drive minimum track width"
   (condition "A.NetClass == 'IR_Drive'")
   (constraint track_width (min 0.45mm)))

# Power nets (+5V/+3.3V/GND drops) carry the WiFi + IR-pulse load, routed at the
# 0.6 mm class nominal. Floor them so a future edit / re-route can't silently
# neck one to a signal width. Enabled by the 2026-06-15 decoupling re-seat
# re-route, which cleared the old 0.2 mm +3.3V segments (FreeRouting now holds
# the class width; min observed 0.50 mm at a few pad-entry necks). A 0.5 mm
# floor passes those and bites only a real regression. (See layout.md.)
(rule "Power minimum track width"
   (condition "A.NetClass == 'Power'")
   (constraint track_width (min 0.5mm)))
