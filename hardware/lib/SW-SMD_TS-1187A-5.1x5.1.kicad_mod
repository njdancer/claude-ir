(module "SW-SMD_TS-1187A-5.1x5.1" (layer F.Cu) (tedit 0)
  (descr "XKB TS-1187A-B-A-B tact switch, SMD 5.1x5.1mm body, 4 gull-wing terminals. Datasheet land pattern: pads 1.0x0.75 at +/-3.0 x, +/-1.875 y. Pins on the same horizontal row are internally common (A-B top, C-D bottom), so pads carry two numbers only: row 1 = pole 1, row 2 = pole 2 - matches a generic 2-pin SW_Push symbol.")
  (tags "tact switch TS-1187A C318884")
  (attr smd)
  (fp_text reference REF** (at 0 -3.8) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value SW-SMD_TS-1187A-5.1x5.1 (at 0 3.8) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start -2.55 -2.55) (end 2.55 -2.55) (layer F.SilkS) (width 0.15))
  (fp_line (start -2.55 2.55) (end 2.55 2.55) (layer F.SilkS) (width 0.15))
  (fp_line (start -2.55 -0.9) (end -2.55 0.9) (layer F.SilkS) (width 0.15))
  (fp_line (start 2.55 -0.9) (end 2.55 0.9) (layer F.SilkS) (width 0.15))
  (fp_circle (center 0 0) (end 1.0 0) (layer F.SilkS) (width 0.15))
  (fp_line (start -2.55 -2.55) (end 2.55 -2.55) (layer F.Fab) (width 0.1))
  (fp_line (start 2.55 -2.55) (end 2.55 2.55) (layer F.Fab) (width 0.1))
  (fp_line (start 2.55 2.55) (end -2.55 2.55) (layer F.Fab) (width 0.1))
  (fp_line (start -2.55 2.55) (end -2.55 -2.55) (layer F.Fab) (width 0.1))
  (fp_circle (center 0 0) (end 1.0 0) (layer F.Fab) (width 0.1))
  (fp_rect (start -3.75 -2.8) (end 3.75 2.8) (layer F.CrtYd) (width 0.05))
  (pad "1" smd rect (at -3.0 -1.875) (size 1.0 0.75) (layers F.Cu F.Mask F.Paste))
  (pad "1" smd rect (at 3.0 -1.875) (size 1.0 0.75) (layers F.Cu F.Mask F.Paste))
  (pad "2" smd rect (at -3.0 1.875) (size 1.0 0.75) (layers F.Cu F.Mask F.Paste))
  (pad "2" smd rect (at 3.0 1.875) (size 1.0 0.75) (layers F.Cu F.Mask F.Paste))
  (fp_text user ${REFERENCE} (at 0 0) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
)
